                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('error code is missing_parameter', () => pm.expect(pm.response.json().error).to.eql('missing_parameter'));",
                  "pm.test('response time < 1000 ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
